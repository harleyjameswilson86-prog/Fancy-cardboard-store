const API_URL = 'https://fancy-cardboard-stripe-backend.onrender.com';

function loadCart() {
const cart = JSON.parse(localStorage.getItem('cart') || '[]');
const container = document.getElementById('order-items');
if (cart.length === 0) {
container.innerHTML = 'Your cart is empty.
';
updateTotals(0);
return;
}
let html = '';
let subtotal = 0;
cart.forEach(item => {
const price = parseFloat(item.price) || 0;
const qty = item.quantity || 1;
subtotal += price * qty;
html += '' + (item.name || 'Product') + ' x' + qty + '$' + (price * qty).toFixed(2) + '
';
});
container.innerHTML = html;
document.getElementById('subtotal').textContent = '$' + subtotal.toFixed(2);
updateTotals(subtotal);
}

function updateTotals() {
const subtotal = parseFloat(document.getElementById('subtotal').textContent.replace('$','')) || 0;
const shippingEl = document.querySelector('input[name="shipping"]:checked');
const shippingCost = shippingEl && shippingEl.value === 'delivery' ? 10 : 0;
document.getElementById('shipping-cost').textContent = shippingCost === 0 ? 'FREE' : '$' + shippingCost.toFixed(2);
document.getElementById('total').textContent = '$' + (subtotal + shippingCost).toFixed(2);
}

async function processCheckout() {
const email = document.getElementById('email').value;
const name = document.getElementById('name').value;
const phone = document.getElementById('phone').value;
const address = document.getElementById('address').value;
const suburb = document.getElementById('suburb').value;
const state = document.getElementById('state').value;
const postcode = document.getElementById('postcode').value;
const shipping = document.querySelector('input[name="shipping"]:checked').value;
const notes = document.getElementById('notes').value;

if (!email || !name || !phone || !address || !suburb || !state || !postcode) {
alert('Please fill in all required fields.');
return;
}
const cart = JSON.parse(localStorage.getItem('cart') || '[]');
if (cart.length === 0) { alert('Your cart is empty.'); return; }

const subtotal = cart.reduce((sum, item) => sum + (parseFloat(item.price) || 0) * (item.quantity || 1), 0);
const shippingCost = shipping === 'delivery' ? 10 : 0;

try {
const response = await fetch(API_URL + '/create-checkout-session', {
method: 'POST',
headers: {'Content-Type': 'application/json'},
body: JSON.stringify({
items: cart.map(item => ({id: item.id, quantity: item.quantity || 1})),
customer: {email, name, phone, address, suburb, state, postcode, shipping, notes},
successUrl: window.location.origin + '/success.html',
cancelUrl: window.location.origin + '/cancel.html'
})
});
if (!response.ok) throw new Error('Checkout failed');
const {url} = await response.json();
window.location.href = url;
} catch (err) { alert('Error: ' + err.message); }
}
loadCart();
